# =================================================================
# BRIDGEMATE BACKEND CONFIGURATION
# Copy this file to .env and provide your secret keys below.
# =================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="BridgeMate Backend API"
VERSION=1.0.0

# Security (Change in production! Must be 32+ characters)
SECRET_KEY=BRIDGEMATE_CHANGE_THIS_SECRET_KEY_FOR_JWT_SECURITY_32_BYTES_MIN

# Database Connection
# Local SQLite for immediate zero-config testing:
DATABASE_URL=sqlite+aiosqlite:///./bridgemate.db
# PostgreSQL with pgvector for Docker / Production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bridgemate

# Redis (Optional)
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------
# AI PROVIDERS (Fallback order: Gemini -> Groq -> Offline FAQ)
# -----------------------------------------------------------------
# 1. Google Gemini API Key: Obtain from https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# 2. Groq Cloud API Key: Obtain from https://console.groq.com/
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------
# TELEGRAM BOT INTEGRATION
# -----------------------------------------------------------------
# Bot Token: Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_WEBHOOK_SECRET=bridgemate_tg_webhook_secret_key
TELEGRAM_BOT_USERNAME=BridgeMateBot

# -----------------------------------------------------------------
# CORS & FRONTEND PLUGIN SETTINGS
# -----------------------------------------------------------------
# Comma-separated allowed origins or * for embeddable plugin
CORS_ORIGINS=*
